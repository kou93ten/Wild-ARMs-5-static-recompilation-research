+    }
+    mapping += ",leftx:a0,lefty:a1";
+    if (axes >= 4) mapping += ",rightx:a2,righty:a3";
+    if (hats > 0) mapping += ",dpup:h0.1,dpright:h0.2,dpdown:h0.4,dpleft:h0.8";
+    std::fprintf(stderr, "[pad] %s (%s): %d axes, %d buttons, %d hats; trying %s fallback layout%s\n",
