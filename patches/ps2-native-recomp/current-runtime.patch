+// The location heading is already in the GS framebuffer of a loaded menu
+// state, so no glyph draw is available. Reconstruct that small raster region
+// from the game's own pixels. The cubic is clamped to neighbouring pixel
+// colours so its ringing cannot make the letters brighter than the source.
+fn wa5_cached_heading(uv: vec2<f32>) -> bool {
+    if ((blit.options & 8u) == 0u || blit.height % 448u != 0u) { return false; }
+    let n = blit.height / 448u;
+    if (n <= 1u || blit.width != 512u * n) { return false; }
+    let p = uv * vec2<f32>(512.0, 448.0);
+    if (p.x < 64.0 || p.x >= 199.0 || p.y < 20.0 || p.y >= 45.0) { return false; }
+    let yn = i32(35u * n + n / 2u);
+    return luma(scene_texel(i32(70u * n + n / 2u), yn)) < 0.18 &&
+           luma(scene_texel(i32(193u * n + n / 2u), yn)) < 0.18;
+}
+
+fn wa5_heading_texel(x: i32, y: i32) -> vec3<f32> {
+    let n = i32(blit.height / 448u);
+    return scene_texel(x * n + n / 2, y * n + n / 2);
+}
+
+fn wa5_heading_sample(uv: vec2<f32>) -> vec3<f32> {
+    let p = uv * vec2<f32>(512.0, 448.0) - 0.5;
+    let x = i32(floor(p.x));
+    let y = i32(floor(p.y));
+    let f = fract(p);
+    let wx = catmull_rom(f.x);
+    let wy = catmull_rom(f.y);
+    let r0 = row4(wa5_heading_texel(x - 1, y - 1), wa5_heading_texel(x, y - 1), wa5_heading_texel(x + 1, y - 1), wa5_heading_texel(x + 2, y - 1), wx);
+    let r1 = row4(wa5_heading_texel(x - 1, y), wa5_heading_texel(x, y), wa5_heading_texel(x + 1, y), wa5_heading_texel(x + 2, y), wx);
+    let r2 = row4(wa5_heading_texel(x - 1, y + 1), wa5_heading_texel(x, y + 1), wa5_heading_texel(x + 1, y + 1), wa5_heading_texel(x + 2, y + 1), wx);
+    let r3 = row4(wa5_heading_texel(x - 1, y + 2), wa5_heading_texel(x, y + 2), wa5_heading_texel(x + 1, y + 2), wa5_heading_texel(x + 2, y + 2), wx);
+    let a = wa5_heading_texel(x, y);
+    let b = wa5_heading_texel(x + 1, y);
+    let c = wa5_heading_texel(x, y + 1);
+    let d = wa5_heading_texel(x + 1, y + 1);
+    return clamp(row4(r0, r1, r2, r3, wy), min(min(a, b), min(c, d)), max(max(a, b), max(c, d)));
+}
