+    char guid[33] = {};
+    SDL_JoystickGetGUIDString(SDL_JoystickGetDeviceGUID(device), guid, sizeof guid);
+    if ((type != SDL_JOYSTICK_TYPE_UNKNOWN && type != SDL_JOYSTICK_TYPE_GAMECONTROLLER) || axes < 2 || buttons < 4) {
+        std::fprintf(stderr, "[pad] %s (%s): %d axes, %d buttons, %d hats; no gamepad layout (wheel/flight devices are left alone)\n",
+                     device_name, guid, axes, buttons, hats);
+        SDL_JoystickClose(stick);
+        return false;
+    }
+    std::string name = device_name;
+    std::replace(name.begin(), name.end(), ',', ' ');
+    std::string lower = name;
