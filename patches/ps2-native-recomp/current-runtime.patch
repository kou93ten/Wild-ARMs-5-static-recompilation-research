+    const int ofx = static_cast<int>(ctx.xyoffset & 0xFFFFu);
+    const int ofy = static_cast<int>((ctx.xyoffset >> 32) & 0xFFFFu);
+    const float x0 = (static_cast<int>(s.queue[0].x) - ofx) / 16.0f;
+    const float x1 = (static_cast<int>(s.queue[1].x) - ofx) / 16.0f;
+    const float y0 = (static_cast<int>(s.queue[0].y) - ofy) / 16.0f;
