+                             lower.find("ps3 controller") != std::string::npos || lower.find("ps4 controller") != std::string::npos ||
+                             lower.find("ps5 controller") != std::string::npos;
+    std::string mapping = std::string(guid) + "," + name + (playstation ? ",a:b1,b:b2,x:b0,y:b3" : ",a:b0,b:b1,x:b2,y:b3");
+    const auto bind_button = [&](const char *action, int index) {
+        if (buttons > index) mapping += std::string(",") + action + ":b" + std::to_string(index);
+    };
+    bind_button("leftshoulder", 4);
+    bind_button("rightshoulder", 5);
+    bind_button("back", playstation ? 8 : 6);
+    bind_button("start", playstation ? 9 : 7);
+    bind_button("leftstick", playstation ? 10 : 8);
+    bind_button("rightstick", playstation ? 11 : 9);
+    SDL_JoystickUpdate();
+    if (playstation) {
+        bind_button("lefttrigger", 6);
