+            const double fx = (static_cast<double>(x) + 0.5) * sw / vw - 0.5;
+            const std::uint32_t x0 = static_cast<std::uint32_t>(std::clamp(std::floor(fx), 0.0, static_cast<double>(sw - 1)));
