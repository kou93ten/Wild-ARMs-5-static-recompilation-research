+bool add_fallback_mapping(int device) {
+    SDL_Joystick *stick = SDL_JoystickOpen(device);
+    if (!stick) {
+        std::fprintf(stderr, "[pad] cannot inspect joystick %d: %s\n", device, SDL_GetError());
+        return false;
